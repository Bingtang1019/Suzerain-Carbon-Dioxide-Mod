# ============================================================
# Oikonomia (.gitignore)
# 原则：源码 / 文档 / 脚本入库；
#       构建产物、打包产物、游戏存档、32MB 级前置包一律不入库。
# ============================================================

# ---------- 构建产物（dotnet build / MSBuild）----------
bin/
obj/
dist/
_staging/
.vs/
*.user
*.suo

# ---------- 打包产物 / 运行时生成物 ----------
# dist/*.zip（Full 包约 32 MB）、_staging/pack-full/BepInEx-*.zip（约 32 MB）
*.zip
*.log
*.exe

# ---------- 游戏存档备份 ----------
# _saves-backup-20260927-160521/ 约 135 MB / 132 个存档 JSON —— 绝不入库
_saves-backup-*/

# ============================================================
# 明确入库的内容（勿删）：
#   src/**/*.cs          模组与探针源码（Oikonomia / OI.Probe）
#   src/**/*.csproj      MSBuild 工程文件
#   tests/**/*.cs        DecreeLimitTest / EdgeSnapshotCompat
#   tests/_baseline/     Oikonomia.phase0.dll（64 KB 基线夹具，非构建产物）
#   tools/**/*.ps1       pack-/check-/run- 等构建脚本
#   tools/installer-src/install.bat + install.ps1（安装脚本，必须入库）
#   tools/_cmp/*.cs      cmp 工具源码（仅其 bin/ obj/ 被忽略）
#   docs/**  README.md  CHANGELOG.md
# ============================================================

# simulator artifacts (large; regenerated by tools\extract-dialogue-nodes.ps1)
_out/graph/*.jsonl
